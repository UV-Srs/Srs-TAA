# ===================================================================
# TAA – Inspection Management System  |  Backend Environment Config
# ===================================================================
# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env to version control.
# ===================================================================

# ── Database ───────────────────────────────────────────────────────
# DB type: 'postgresql' (recommended for production) or 'sqlite' (dev only)
DB_TYPE=postgresql

DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Change this to any name — the backend creates all tables automatically
# on startup (no manual migration scripts needed).
# To use a new database: CREATE DATABASE <name>; in PostgreSQL first,
# then update this value and restart the backend.
DB_NAME=taa_inspection

# Optional: override the full connection URL directly
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/taa_inspection

# ── Security ───────────────────────────────────────────────────────
# Generate a SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The server will not start without this value set.
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_SECRETS_TOKEN_HEX_32

ALGORITHM=HS256

# Token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (comma-separated allowed origins) ─────────────────────────
# Add your LAN IP if accessing from mobile or other devices
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
