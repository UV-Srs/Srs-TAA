# ===================================================================
# TAA – Docker / Production Environment
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ===================================================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECRETS_TOKEN_HEX_32

# PostgreSQL credentials (must match between db and app services)
DB_USER=taa
DB_PASSWORD=choose_a_strong_password
DB_NAME=taa_inspection

# CORS — add your LAN IP if accessing from phones on the same network
# e.g. http://192.168.1.100:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000
